# Copy to .env and fill in. Never commit real values.
# server/config/env.ts is the source of truth for every variable here.

# Required

# The Postgres database that holds auto-book jobs: a postgres:// URL.
DATABASE_URL=

# Encrypts stored Disney logins: 32 random bytes, standard base64 (not
# base64url). Changing it makes running jobs fail.
LOGIN_ENCRYPTION_KEY=

# The Web Push key pair, base64url: 65 bytes public, 32 bytes private.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The contact push services are given: an https: or mailto: URL.
VAPID_SUBJECT=

# Optional

# development (default), production or test. production logs JSON.
NODE_ENV=

# debug, info (default), warn or error.
LOG_LEVEL=

# The port to listen on. Defaults to 8080.
PORT=

# Milliseconds a job waits between two checks. Defaults to 1000, at least 100.
AUTO_BOOK_POLL_INTERVAL_MS=

# Requests one job may send Disney per second before it stops itself.
# Defaults to the lowest value the poll interval can never reach.
DISNEY_REQUESTS_PER_SECOND=

# Proxies as host:port:username:password, separated by commas or new lines.
DISNEY_PROXIES=

# true sends each job's requests through one of DISNEY_PROXIES. Defaults to
# false.
DISNEY_USE_PROXIES=
